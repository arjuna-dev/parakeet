# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    if target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        if file.settings && file.settings['COMPILER_FLAGS']
          flags = file.settings['COMPILER_FLAGS'].split
          flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
          file.settings['COMPILER_FLAGS'] = flags.join(' ')
        end
      end
    end
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
      # Fix for gRPC-Core template parsing issue
      if target.name == 'gRPC-Core'
        config.build_settings['GCC_C_LANGUAGE_STANDARD'] = 'c11'
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '$(inherited) -std=c++17 -Wno-template-id-cdtor'
      end
    end
  end
  
  # Patch gRPC-Core xcconfig files to use C++17
  Dir.glob('Pods/Target Support Files/gRPC-Core/*.xcconfig').each do |config_file|
    begin
      text = File.read(config_file)
      new_contents = text.gsub(/CLANG_CXX_LANGUAGE_STANDARD = c\+\+14/, 'CLANG_CXX_LANGUAGE_STANDARD = c++17')
      if text != new_contents
        File.chmod(0644, config_file) if File.exist?(config_file)
        File.open(config_file, "w") { |file| file.puts new_contents }
      end
    rescue => e
      puts "Warning: Could not patch #{config_file}: #{e.message}"
    end
  end

  # Patch basic_seq.h to fix template parsing issue in gRPC
  # This fixes: "A template argument list is expected after a name prefixed by the template keyword"
  ['Pods/gRPC-Core/src/core/lib/promise/detail/basic_seq.h', 
   'Pods/gRPC-C++/src/core/lib/promise/detail/basic_seq.h'].each do |file_path|
    if File.exist?(file_path)
      begin
        text = File.read(file_path)
        # Remove 'template' keyword which causes parsing error in this context
        new_contents = text.gsub('Traits::template CallSeqFactory', 'Traits::CallSeqFactory')
        if text != new_contents
          File.chmod(0644, file_path)
          File.open(file_path, "w") { |file| file.puts new_contents }
          puts "Patched #{file_path}"
        end
      rescue => e
        puts "Warning: Could not patch #{file_path}: #{e.message}"
      end
    end
  end
end
